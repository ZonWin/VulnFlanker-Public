VULNFLANKER_APP_NAME=VulnFlanker
VULNFLANKER_APP_ENV=development

# v0.1 MVP default network boundary:
# keep control-plane services local by default. Set
# VULNFLANKER_AGENT_INGRESS_BIND=0.0.0.0 only when remote Agents need to reach
# this host, and protect that port with a firewall or reverse proxy.
VULNFLANKER_API_PREFIX=/api/v1
VULNFLANKER_AGENT_API_PREFIX=/agent/v1
VULNFLANKER_API_BIND=127.0.0.1
VULNFLANKER_API_PORT=8000
VULNFLANKER_AGENT_INGRESS_BIND=127.0.0.1
VULNFLANKER_AGENT_INGRESS_PORT=8001
VULNFLANKER_PUBLIC_AGENT_INGRESS_URL=http://127.0.0.1:8001
VULNFLANKER_FRONTEND_BIND=0.0.0.0
VULNFLANKER_FRONTEND_PORT=8100

# Kept enabled for v0.1 legacy Agent compatibility. New deployments should
# prefer /agent/v1 and plan to disable this in a future hardening release.
VULNFLANKER_LEGACY_AGENT_API_ENABLED=true
VULNFLANKER_DATABASE_URL=postgresql+psycopg://vulnflanker:vulnflanker@localhost:5432/vulnflanker
# Use a URL-safe random value and keep the Redis URLs below in sync.
VULNFLANKER_REDIS_BIND=127.0.0.1
VULNFLANKER_REDIS_PORT=6379
VULNFLANKER_REDIS_PASSWORD=change-this-redis-password
VULNFLANKER_REDIS_URL=redis://:change-this-redis-password@localhost:6379/0
VULNFLANKER_CELERY_BROKER_URL=redis://:change-this-redis-password@localhost:6379/0
VULNFLANKER_CELERY_RESULT_BACKEND=redis://:change-this-redis-password@localhost:6379/1
VULNFLANKER_LOG_LEVEL=INFO
VULNFLANKER_CISA_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
VULNFLANKER_CISA_KEV_CATALOG_URL=https://www.cisa.gov/known-exploited-vulnerabilities-catalog
VULNFLANKER_CISA_KEV_CVE_RECORD_URL_TEMPLATE=https://cveawg.mitre.org/api/cve/{cve_id}
VULNFLANKER_CISA_KEV_CVE_RECORD_FETCH=true
VULNFLANKER_CISA_KEV_CVE_RECORD_WORKERS=8
VULNFLANKER_CISA_KEV_MONITOR_ENABLED=true
VULNFLANKER_CISA_KEV_MONITOR_INTERVAL_SECONDS=86400
VULNFLANKER_CISA_KEV_MONITOR_LIMIT=
VULNFLANKER_CISA_KEV_MONITOR_TICK_SECONDS=300
VULNFLANKER_ALIYUN_AVD_HIGH_RISK_URL=https://avd.aliyun.com/high-risk/list
VULNFLANKER_WATCHVULN_COLLECTOR_COMMAND=
VULNFLANKER_WATCHVULN_COLLECTOR_PATH=
VULNFLANKER_WATCHVULN_COLLECTOR_TIMEOUT_SECONDS=300
VULNFLANKER_WATCHVULN_SOURCES=avd,chaitin,oscs,ti,threatbook,seebug,struts2,kev,venustech
VULNFLANKER_WATCHVULN_PAGE_LIMIT=1
VULNFLANKER_WATCHVULN_VALUABLE_ONLY=true
VULNFLANKER_WATCHVULN_PROXY=
VULNFLANKER_WATCHVULN_SKIP_TLS_VERIFY=false
VULNFLANKER_WATCHVULN_MONITOR_ENABLED=false
VULNFLANKER_WATCHVULN_MONITOR_INTERVAL_SECONDS=1800
VULNFLANKER_WATCHVULN_MONITOR_LIMIT=
# Change this before any shared or production-like deployment.
VULNFLANKER_INTEL_WEBHOOK_TOKEN=change-me
VULNFLANKER_INTEL_WEBHOOK_MAX_BODY_BYTES=1000000
VULNFLANKER_RISK_WEIGHT_SEVERITY=0.30
VULNFLANKER_RISK_WEIGHT_EXPLOITABILITY=0.18
VULNFLANKER_RISK_WEIGHT_EXPOSURE=0.15
VULNFLANKER_RISK_WEIGHT_BUSINESS_CRITICALITY=0.17
VULNFLANKER_RISK_WEIGHT_CONFIDENCE=0.08
VULNFLANKER_RISK_WEIGHT_VERIFICATION=0.07
VULNFLANKER_RISK_WEIGHT_ASSET_FRESHNESS=0.05
VULNFLANKER_VERIFICATION_QUEUED_TIMEOUT_SECONDS=86400
VULNFLANKER_VERIFICATION_IN_PROGRESS_TIMEOUT_SECONDS=3600
VULNFLANKER_BOOTSTRAP_ADMIN_USERNAME=admin
# Leave empty to use the first-run setup page. If set in shared environments,
# use a strong one-time password and rotate it after first login.
VULNFLANKER_BOOTSTRAP_ADMIN_PASSWORD=
VULNFLANKER_BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
VULNFLANKER_SESSION_COOKIE_NAME=vulnflanker_session
VULNFLANKER_SESSION_TTL_SECONDS=86400
# Set true behind HTTPS in production or shared environments.
VULNFLANKER_SESSION_COOKIE_SECURE=false
# Required when saving AI provider API keys. Use a long random value and back it
# up; losing it makes stored AI keys unrecoverable.
VULNFLANKER_AI_KEY_ENCRYPTION_KEY=

# Frontend build-time overrides. Leave empty for the containerized frontend so
# Nginx serves the SPA and proxies same-origin /api and /agent requests.
VITE_API_BASE_URL=
VITE_AGENT_INGRESS_BASE_URL=

# Host Agent MVP
VULNFLANKER_AGENT_INGRESS_URL=http://127.0.0.1:8001
VULNFLANKER_AGENT_ENROLLMENT_TOKEN=
VULNFLANKER_AGENT_SECRET_FILE=
VULNFLANKER_SERVER_URL=http://127.0.0.1:8000
VULNFLANKER_AGENT_STATE_DIR=.vulnflanker-agent
VULNFLANKER_AGENT_LOG_DIR=.vulnflanker-agent
VULNFLANKER_AGENT_ENVIRONMENT_TYPE=production
VULNFLANKER_AGENT_EXPOSURE_TYPE=internal
VULNFLANKER_AGENT_CRITICALITY=medium
VULNFLANKER_AGENT_ALLOW_AUTO_VERIFY=true
VULNFLANKER_AGENT_ALLOW_AUTO_REMEDIATE=false
